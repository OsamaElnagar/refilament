<?php

declare(strict_types=1);

namespace {{ namespace }};

use Refilament\Refilament\Resources\Resource;
use Refilament\Refilament\Schemas\Schema;
use Refilament\Refilament\Tables\Table;
use {{ schemaFqn }};
use {{ tableFqn }};
use {{ modelImport }};

class {{ class }} extends Resource
{
    /**
     * The Eloquent model this resource manages.
     *
     * @var class-string
     */
    protected static ?string $model = {{ modelShort }}::class;

    // Override to change the ids the typed endpoints serve this resource under:
    // protected static ?string $tableId = 'posts';
    // protected static ?string $formId = 'post-form';

    /**
     * The table definition — delegated to the standalone class so the same
     * table can be reused by relation managers, widgets and cross-cutting
     * components (docs/ARCHITECTURE.md, "Reusable table/form classes").
     */
    public static function table(Table $table): Table
    {
        return {{ tableShort }}::configure($table);
    }

    /**
     * The form schema — likewise extracted into a standalone, reusable class.
     */
    public static function form(Schema $schema): Schema
    {
        return {{ schemaShort }}::configure($schema);
    }
}